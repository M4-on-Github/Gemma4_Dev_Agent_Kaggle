+def _walk_tb(
+    traceback: Optional[TracebackType],
+) -> Iterable[Tuple[TracebackType, Any, int]]:
+    """Walk a traceback, yielding the traceback object, frame, and line number."""
+    while traceback is not None:
+        yield traceback, traceback.tb_frame, traceback.tb_lineno
+        traceback = traceback.tb_next
+
+
+def _get_last_instruction(
+    traceback: TracebackType,
+) -> Optional[Tuple[Tuple[int, int], Tuple[int, int]]]:
+    """Get the fine grained location (PEP 657) of the last executed instruction.
+
+    Returns:
+        Optional[Tuple[Tuple[int, int], Tuple[int, int]]]: ((start line, start column),
+            (end line, end column)), or None if not available.
+    """
+    if sys.version_info < (3, 11):
+        return None
+    try:
+        lasti = traceback.tb_lasti
+        if lasti < 0:
+            return None
+        instruction_index = lasti // 2
+        position = next(
+            islice(
+                traceback.tb_frame.f_code.co_positions(),
+                instruction_index,
+                instruction_index + 1,
+            ),
+            None,
+        )
+    except Exception:
+        return None
+    if position is None:
+        return None
+    start_line, end_line, start_column, end_column = position
+    if (
+        start_line is None
+        or end_line is None
+        or start_column is None
+        or end_column is None
+    ):
+        return None
+    return ((start_line, start_column), (end_line, end_column))
 
 
