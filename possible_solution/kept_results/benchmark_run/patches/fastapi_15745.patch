+class _IncludedRouterView(_RouterNode):
+    """
+    A nested included router (`base`), as seen through an outer inclusion
+    (`outer`), e.g. when `app` includes `router` and `router` includes
+    `sub_router`, the view of `sub_router` from `app`.
+    """
+
+    def __init__(self, *, base: _RouterNode, outer: _IncludedRouter) -> None:
+        super().__init__()
+        self.base = base
+        self.outer = outer
+        self.router = base.router
