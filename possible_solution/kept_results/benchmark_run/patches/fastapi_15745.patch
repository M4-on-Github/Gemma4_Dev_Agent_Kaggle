+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}(base={self.base!r}, outer={self.outer!r})"
+
+    def _get_sources(self) -> Sequence[BaseRoute]:
+        return self.base.routes
+
+    def _resolve(self, source: BaseRoute) -> BaseRoute | None:
+        return self.outer._resolve(source)
