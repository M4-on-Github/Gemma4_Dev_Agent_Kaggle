+# Private scope keys used while matching and handling requests through included
+# routers.
+# The node (included router) currently being matched or handled.
+_ROUTER_NODE_SCOPE_KEY = "fastapi.router_node"
+# A mapping of the id of each router context (node) to the route it matched.
+_ROUTER_MATCHES_SCOPE_KEY = "fastapi.router_matches"
+
+
+def _same_items(a: Sequence[Any], b: Sequence[Any]) -> bool:
+    return len(a) == len(b) and all(x is y for x, y in zip(a, b, strict=True))
+
+
+def _router_includes(router: APIRouter, target: APIRouter) -> bool:
+    """
+    Check if `router` includes `target`, directly or indirectly.
+    """
+    pending: list[APIRouter] = [router]
+    seen: set[int] = set()
+    while pending:
+        current = pending.pop()
+        if id(current) in seen:
+            continue
+        seen.add(id(current))
+        for route in current.routes:
+            if isinstance(route, _RouterNode):
+                if route.router is target:
+                    return True
+                pending.append(route.router)
+    return False
+
+
+def _flatten_routes(routes: Iterable[BaseRoute]) -> list[BaseRoute]:
+    """
+    Get the plain list of the final (effective) routes, expanding the tree of
+    included routers.
+    """
+    result: list[BaseRoute] = []
+    for route in routes:
+        if isinstance(route, _RouterNode):
+            result.extend(_flatten_routes(route.routes))
+        else:
+            result.append(route)
+    return result
+
+
+def _get_router_context(router: APIRouter, scope: Scope) -> tuple[int, list[BaseRoute]]:
+    node = scope.get(_ROUTER_NODE_SCOPE_KEY)
+    if isinstance(node, _RouterNode) and node.router is router:
+        return id(node), node.routes
+    return id(router), router.routes
+
+
+def _add_router_match(child_scope: Scope, key: int, route: BaseRoute) -> Scope:
+    matches = {**child_scope.get(_ROUTER_MATCHES_SCOPE_KEY, {}), key: route}
+    return {**child_scope, _ROUTER_MATCHES_SCOPE_KEY: matches}
+
+
+class _RouterNode(BaseRoute):
+    """
+    Base class for the intermediate objects stored in `router.routes` that
+    represent another router included in it.
+
+    The included router (and its routes) are preserved as is, the final
+    (effective) routes, with the prefix, tags, dependencies, etc. from each
+    inclusion applied, are computed lazily (and cached) from them, so that any
+    route added to the included router later is also reflected.
+    """
+
+    router: APIRouter
+
+    def __init__(self) -> None:
+        self._sources: list[BaseRoute] = []
+        self._resolved: list[BaseRoute] = []
+        self._cache: dict[int, tuple[BaseRoute, BaseRoute | None]] = {}
+
+    def _get_sources(self) -> Sequence[BaseRoute]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def _resolve(self, source: BaseRoute) -> BaseRoute | None:
+        raise NotImplementedError()  # pragma: no cover
+
+    @property
+    def routes(self) -> list[BaseRoute]:
+        """
+        The effective routes (and nested included routers) for this inclusion.
+        """
+        sources = self._get_sources()
+        if _same_items(sources, self._sources):
+            return self._resolved
+        cache: dict[int, tuple[BaseRoute, BaseRoute | None]] = {}
+        resolved: list[BaseRoute] = []
+        for source in sources:
+            cached = self._cache.get(id(source))
+            if cached is not None and cached[0] is source:
+                route = cached[1]
+            else:
+                route = self._resolve(source)
+            cache[id(source)] = (source, route)
+            if route is not None:
+                resolved.append(route)
+        self._sources = list(sources)
+        self._resolved = resolved
+        self._cache = cache
+        return resolved
+
+    def matches(self, scope: Scope) -> tuple[Match, Scope]:
+        return self.router.matches({**scope, _ROUTER_NODE_SCOPE_KEY: self})
+
+    async def handle(self, scope: Scope, receive: Receive, send: Send) -> None:
+        scope[_ROUTER_NODE_SCOPE_KEY] = self
+        await self.router.handle(scope, receive, send)
+
+    def url_path_for(self, name: str, /, **path_params: Any) -> URLPath:
+        for route in self.routes:
+            try:
+                return route.url_path_for(name, **path_params)
+            except NoMatchFound:
+                pass
+        raise NoMatchFound(name, path_params)
+
+
+class _IncludedRouter(_RouterNode):
+    """
+    A router included in another router (the `parent`), with the parameters
+    passed to `parent.include_router()`.
+    """
+
+    def __init__(
+        self,
+        *,
+        parent: APIRouter,
+        router: APIRouter,
+        prefix: str = "",
+        tags: list[str | Enum] | None = None,
+        dependencies: Sequence[params.Depends] | None = None,
+        default_response_class: type[Response] = Default(JSONResponse),
+        responses: dict[int | str, dict[str, Any]] | None = None,
+        callbacks: list[BaseRoute] | None = None,
+        deprecated: bool | None = None,
+        include_in_schema: bool = True,
+        generate_unique_id_function: Callable[[APIRoute], str]
+        | DefaultPlaceholder = Default(generate_unique_id),
+    ) -> None:
+        super().__init__()
+        self.parent = parent
+        self.router = router
+        self.prefix = prefix
+        self.tags: list[str | Enum] = list(tags or [])
+        self.dependencies: list[params.Depends] = list(dependencies or [])
+        self.default_response_class = default_response_class
+        self.responses: dict[int | str, dict[str, Any]] = dict(responses or {})
+        self.callbacks: list[BaseRoute] = list(callbacks or [])
+        self.deprecated = deprecated
+        self.include_in_schema = include_in_schema
+        self.generate_unique_id_function = generate_unique_id_function
+
+    def __repr__(self) -> str:
+        return (
+            f"{self.__class__.__name__}(router={self.router!r}, prefix={self.prefix!r})"
+        )
+
+    def _get_sources(self) -> Sequence[BaseRoute]:
+        return self.router.routes
+
+    def _resolve(self, source: BaseRoute) -> BaseRoute | None:
+        if isinstance(source, _RouterNode):
+            return _IncludedRouterView(base=source, outer=self)
+        return self._include_route(source)
+
+    def _include_route(self, route: BaseRoute) -> BaseRoute | None:
+        parent = self.parent
+        router = self.router
+        prefix = self.prefix
+        if not prefix:
+            path = getattr(route, "path", None)
+            if path is not None and not path:
+                name = getattr(route, "name", "unknown")
+                raise FastAPIError(
+                    f"Prefix and path cannot be both empty (path operation: {name})"
+                )
+        if isinstance(route, APIRoute):
+            combined_responses = {**self.responses, **route.responses}
+            use_response_class = get_value_or_default(
+                route.response_class,
+                router.default_response_class,
+                self.default_response_class,
+                parent.default_response_class,
+            )
+            current_tags = [*self.tags, *route.tags]
+            current_dependencies = [*self.dependencies, *route.dependencies]
+            current_callbacks = [*self.callbacks, *(route.callbacks or [])]
+            current_generate_unique_id = get_value_or_default(
+                route.generate_unique_id_function,
+                router.generate_unique_id_function,
+                self.generate_unique_id_function,
+                parent.generate_unique_id_function,
+            )
+            return parent._create_api_route(
+                prefix + route.path,
+                route.endpoint,
+                response_model=route.response_model,
+                status_code=route.status_code,
+                tags=current_tags,
+                dependencies=current_dependencies,
+                summary=route.summary,
+                description=route.description,
+                response_description=route.response_description,
+                responses=combined_responses,
+                deprecated=route.deprecated or self.deprecated or parent.deprecated,
+                methods=route.methods,
+                operation_id=route.operation_id,
+                response_model_include=route.response_model_include,
+                response_model_exclude=route.response_model_exclude,
+                response_model_by_alias=route.response_model_by_alias,
+                response_model_exclude_unset=route.response_model_exclude_unset,
+                response_model_exclude_defaults=route.response_model_exclude_defaults,
+                response_model_exclude_none=route.response_model_exclude_none,
+                include_in_schema=route.include_in_schema
+                and parent.include_in_schema
+                and self.include_in_schema,
+                response_class=use_response_class,
+                name=route.name,
+                route_class_override=type(route),
+                callbacks=current_callbacks,
+                openapi_extra=route.openapi_extra,
+                generate_unique_id_function=current_generate_unique_id,
+                strict_content_type=get_value_or_default(
+                    route.strict_content_type,
+                    router.strict_content_type,
+                    parent.strict_content_type,
+                ),
+            )
+        elif isinstance(route, routing.Route):
+            return routing.Route(
+                prefix + route.path,
+                endpoint=route.endpoint,
+                methods=list(route.methods or []),
+                name=route.name,
+                include_in_schema=route.include_in_schema,
+            )
+        elif isinstance(route, APIWebSocketRoute):
+            return parent._create_api_websocket_route(
+                prefix + route.path,
+                route.endpoint,
+                name=route.name,
+                dependencies=[*self.dependencies, *route.dependencies],
+            )
+        elif isinstance(route, routing.WebSocketRoute):
+            return routing.WebSocketRoute(
+                prefix + route.path, endpoint=route.endpoint, name=route.name
+            )
+        return None
