+_MAX_CALL_CHAIN_DEPTH = 100
+
+
+def _iter_call_chain(call: Any) -> Iterator[Any]:
+    """
+    Yield each level of a callable, from the outermost to the innermost.
+
+    Partials are skipped (their `.func` is followed), decorator wrappers with
+    `__wrapped__` are followed, and callable instances (not functions nor
+    classes) are followed to their `__call__` method, at any level.
+    """
+    seen: Set[int] = set()
+    current = call
+    for _ in range(_MAX_CALL_CHAIN_DEPTH):
+        if current is None or id(current) in seen:
+            return
+        seen.add(id(current))
+        if isinstance(current, partial):
+            current = current.func
+            continue
+        yield current
+        if inspect.isclass(current):
+            return
+        wrapped = getattr(current, "__wrapped__", None)
+        if wrapped is not None:
+            current = wrapped
+            continue
+        if inspect.isroutine(current):
+            return
+        current = getattr(current, "__call__", None)  # noqa: B004
+
