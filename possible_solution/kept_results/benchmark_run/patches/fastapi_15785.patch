+@dataclass(frozen=True)
+class RouteContext:
+    """
+    The effective information of a route as it is seen by the app, after
+    applying the configuration of all the routers that include it (prefix,
+    tags, dependencies, etc).
+
+    This is returned by `iter_route_contexts()`, `APIRouter.iter_route_contexts()`
+    and `FastAPI.iter_route_contexts()`.
+
+    **Note**: this is intended for advanced use cases that used to iterate over
+    `router.routes` directly. `router.routes` is an internal tree structure that
+    can contain included routers, use `iter_route_contexts()` instead.
+    """
+
+    route: BaseRoute
+    """
+    The original route object, as it was declared (e.g. the `APIRoute` created
+    by a `@router.get()` decorator). This is the same object even when the
+    router that contains it is included in several places.
+    """
+    effective_route: Any
+    """
+    An object with the effective attributes of the route (the same attributes
+    as the original route, e.g. as an `APIRoute`), with the configuration of
+    all the including routers applied. For routes that were not included from
+    another router, this is the same `route`.
+    """
+
+    @property
+    def path(self) -> str:
+        """The full effective path, including the prefixes of all routers."""
+        return cast(str, getattr(self.effective_route, "path", ""))
+
+    @property
+    def path_format(self) -> str:
+        return cast(str, getattr(self.effective_route, "path_format", self.path))
+
+    @property
+    def name(self) -> str | None:
+        return cast(str | None, getattr(self.effective_route, "name", None))
+
+    @property
+    def methods(self) -> set[str] | None:
+        return cast(set[str] | None, getattr(self.effective_route, "methods", None))
+
+    @property
+    def endpoint(self) -> Callable[..., Any] | None:
+        return cast(
+            Callable[..., Any] | None, getattr(self.effective_route, "endpoint", None)
+        )
+
+    @property
+    def include_in_schema(self) -> bool:
+        return cast(bool, getattr(self.effective_route, "include_in_schema", True))
+
+    @property
+    def tags(self) -> list[str | Enum]:
+        return list(getattr(self.effective_route, "tags", None) or [])
+
+    @property
+    def dependencies(self) -> list[params.Depends]:
+        return list(getattr(self.effective_route, "dependencies", None) or [])
+
+
+def iter_route_contexts(routes: Sequence[BaseRoute]) -> Iterator[RouteContext]:
+    """
+    Iterate over all the routes reachable from `routes` (e.g. `app.routes` or
+    `router.routes`), including the routes of included routers (recursively),
+    yielding a `RouteContext` for each one, with the effective path, methods,
+    tags, dependencies, etc.
+    """
+    for route, route_context in _iter_routes_with_context(routes):
+        if route_context is None:
+            yield RouteContext(route=route, effective_route=route)
+        elif isinstance(route, APIRoute):
+            yield RouteContext(route=route, effective_route=route_context)
+        else:
+            yield RouteContext(
+                route=route,
+                effective_route=route_context.starlette_route or route,
+            )
+
+
