+def _unwrapped_call(call: Any) -> Any:
+    """Return the innermost callable, unwrapping `functools.partial` objects and
+    decorators that set `__wrapped__` (e.g. `functools.wraps`, `functools.cache`)."""
+    while True:
+        if isinstance(call, partial):
+            call = call.func
+            continue
+        try:
+            unwrapped = inspect.unwrap(call)
+        except ValueError:  # pragma: no cover
+            # Cycle in __wrapped__ chain
+            return call
+        if unwrapped is call:
+            return call
+        call = unwrapped
+
+
+def _call_candidates(call: Any) -> List[Any]:
+    """Return the callables to inspect to determine the kind of a dependency:
+    the call itself, its unwrapped version, and their `__call__` methods (for
+    callable instances), also unwrapped."""
+    candidates: List[Any] = []
+    unwrapped = _unwrapped_call(call)
+    for candidate in (call, unwrapped):
+        if not any(candidate is c for c in candidates):
+            candidates.append(candidate)
+    if inspect.isclass(unwrapped) or inspect.isroutine(unwrapped):
+        return candidates
+    for candidate in list(candidates):
+        if inspect.isroutine(candidate) or inspect.isclass(candidate):
+            continue
+        dunder_call = getattr(candidate, "__call__", None)  # noqa: B004
+        if dunder_call is None:
+            continue
+        for sub in (dunder_call, _unwrapped_call(dunder_call)):
+            if not any(sub is c for c in candidates):
+                candidates.append(sub)
+    return candidates
+
