@@ -0,0 +1,94 @@
+"""
+Generates the unicode data in rich/_unicode_data from the data in wcwidth
+(https://github.com/jquast/wcwidth).
+
+Run from the tools directory:
+
+    python make_width_tables.py
+
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import wcwidth
+from wcwidth import list_versions, table_vs16
+from wcwidth import wcwidth as get_wcwidth
+
+UNICODE_DATA_PATH = Path(__file__).parent.parent / "rich" / "_unicode_data"
+
+
+def make_widths_table(unicode_version: str) -> list[tuple[int, int, int]]:
+    """Make a table of (START, END, WIDTH) for all codepoints with a width other than 1."""
+    table: list[tuple[int, int, int]] = []
+    append = table.append
+    start_codepoint = end_codepoint = group_width = -1
+    for codepoint in range(0, sys.maxunicode + 1):
+        width = get_wcwidth(chr(codepoint), unicode_version)
+        if width == -1:
+            # Control codes are zero width
+            width = 0
+        if width == 1:
+            continue
+        if width == group_width and codepoint == end_codepoint + 1:
+            end_codepoint = codepoint
+        else:
+            if group_width != -1:
+                append((start_codepoint, end_codepoint, group_width))
+            start_codepoint = end_codepoint = codepoint
+            group_width = width
+    if group_width != -1:
+        append((start_codepoint, end_codepoint, group_width))
+    return table
+
+
+def make_narrow_to_wide(unicode_version: str) -> list[str]:
+    """Characters that become wide when followed by VS16 (\\uFE0F)."""
+    version_numbers = tuple(map(int, unicode_version.split(".")))
+    if version_numbers < (9, 0, 0):
+        return []
+    characters: list[str] = []
+    for start, end in table_vs16.VS16_NARROW_TO_WIDE["9.0.0"]:
+        characters.extend(chr(codepoint) for codepoint in range(start, end + 1))
+    return characters
+
+
+def run() -> None:
+    versions = list_versions()
+    for version in versions:
+        print(f"Generating unicode {version}...")
+        widths = make_widths_table(version)
+        narrow_to_wide = make_narrow_to_wide(version)
+        module_path = UNICODE_DATA_PATH / f"unicode{version.replace('.', '-')}.py"
+        module_path.write_text(
+            f"""\
+# fmt: off
+# Auto generated by tools/make_width_tables.py
+# Data from wcwidth {wcwidth.__version__}
+
+from rich.cells import CellTable
+
+cell_table = CellTable(
+    {version!r},
+    {widths!r},
+    frozenset({narrow_to_wide!r}),
+)
+""",
+            encoding="utf-8",
+        )
+
+    versions_path = UNICODE_DATA_PATH / "_versions.py"
+    versions_path.write_text(
+        f"""\
+# Auto generated by tools/make_width_tables.py
+
+VERSIONS = {tuple(versions)!r}
+""",
+        encoding="utf-8",
+    )
+
+
+if __name__ == "__main__":
+    run()
