diff --git a/rich/_unicode_data/__init__.py b/rich/_unicode_data/__init__.py
new file mode 100644
index 00000000..8655cbaf
--- /dev/null
+++ b/rich/_unicode_data/__init__.py
@@ -0,0 +1,103 @@
+"""
+Unicode data required to calculate the width of text in the terminal.
+
+The data is generated by `tools/make_width_tables.py`, from the data in wcwidth
+(https://github.com/jquast/wcwidth). There is one module per unicode version, which
+is imported only when required, to keep startup time low.
+
+"""
+
+from __future__ import annotations
+
+import bisect
+import os
+from functools import lru_cache
+from importlib import import_module
+from typing import TYPE_CHECKING, Tuple, cast
+
+from ._versions import VERSIONS
+
+if TYPE_CHECKING:
+    from rich.cells import CellTable
+
+__all__ = ["VERSIONS", "load"]
+
+
+def _parse_version(version: str) -> Tuple[int, int, int]:
+    """Parse a version string in to a tuple of three integers.
+
+    Args:
+        version: A version string, e.g. "15.1.0", or "15".
+
+    Raises:
+        ValueError: If the version string is badly formatted.
+
+    Returns:
+        A tuple of (MAJOR, MINOR, PATCH).
+    """
+    try:
+        version_integers = tuple(map(int, version.strip().split(".")))
+    except ValueError:
+        raise ValueError(
+            f"unicode version string {version!r} is badly formatted"
+        ) from None
+    if not version_integers or len(version_integers) > 3:
+        raise ValueError(f"unicode version string {version!r} is badly formatted")
+    version_integers = version_integers + (0,) * (3 - len(version_integers))
+    return cast(Tuple[int, int, int], version_integers)
+
+
+VERSION_ORDER: list[Tuple[int, int, int]] = [
+    _parse_version(version) for version in VERSIONS
+]
+VERSION_SET = frozenset(VERSIONS)
+
+
+def resolve_version(unicode_version: str = "auto") -> str:
+    """Resolve a unicode version string to a version for which we have data.
+
+    Args:
+        unicode_version: A unicode version, `"auto"` to read the `UNICODE_VERSION`
+            environment variable (falling back to latest), or `"latest"` for
+            the most recent version.
+
+    Returns:
+        A version string in `VERSIONS`. If there is no exact match, the closest
+            version prior to the requested version is used.
+    """
+    if unicode_version == "auto":
+        unicode_version = os.environ.get("UNICODE_VERSION", "latest") or "latest"
+    if unicode_version == "latest":
+        return VERSIONS[-1]
+    if unicode_version in VERSION_SET:
+        return unicode_version
+    try:
+        version_numbers = _parse_version(unicode_version)
+    except ValueError:
+        return VERSIONS[-1]
+    version = "{}.{}.{}".format(*version_numbers)
+    if version in VERSION_SET:
+        return version
+    insert_position = bisect.bisect_left(VERSION_ORDER, version_numbers)
+    return VERSIONS[max(0, insert_position - 1)]
+
+
+@lru_cache(maxsize=None)
+def _load_version(version: str) -> "CellTable":
+    module_name = f".unicode{version.replace('.', '-')}"
+    module = import_module(module_name, __name__)
+    return module.cell_table  # type: ignore[no-any-return]
+
+
+@lru_cache(maxsize=64)
+def load(unicode_version: str = "auto") -> "CellTable":
+    """Load a cell table for the given unicode version.
+
+    Args:
+        unicode_version: A unicode version, `"auto"` to read the `UNICODE_VERSION`
+            environment variable, or `"latest"` for the most recent version.
+
+    Returns:
+        A CellTable containing the data required to measure text.
+    """
+    return _load_version(resolve_version(unicode_version))
