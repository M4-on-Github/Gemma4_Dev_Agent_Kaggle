+def _get_type_adapter_config(
+    annotation: Any, config: Union[ConfigDict, None]
+) -> Union[ConfigDict, None]:
+    # Pydantic doesn't allow passing a config to a TypeAdapter for types that
+    # carry their own config (BaseModel, dataclasses, TypedDict), those already
+    # use their own config
+    if (
+        lenient_issubclass(annotation, BaseModel)
+        or is_dataclass(annotation)
+        or is_typeddict(annotation)
+    ):
