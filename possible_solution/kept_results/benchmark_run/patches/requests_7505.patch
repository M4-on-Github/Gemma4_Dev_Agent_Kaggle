+def supports_read(obj: object) -> TypeIs[SupportsRead[Any]]:
+    """Check whether an object provides a ``read`` method.
+
+    ``isinstance`` checks against a runtime protocol miss objects that proxy
+    attribute access to an underlying object via ``__getattr__`` (e.g. the
+    wrapper returned by ``tempfile.NamedTemporaryFile``), so fall back to
+    ``hasattr`` for those.
+    """
+    return isinstance(obj, SupportsRead) or hasattr(obj, "read")
+
