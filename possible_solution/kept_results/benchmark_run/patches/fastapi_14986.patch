 from fastapi.encoders import jsonable_encoder
 from starlette.responses import HTMLResponse
 
+
+def _html_safe_json(value: Any) -> str:
+    """
+    Serialize a value to JSON that is safe to embed inside an HTML `<script>` tag.
+
+    The characters `<`, `>` and `&` are escaped as Unicode escape sequences so that
+    the data can't close the `<script>` tag or open HTML comments/entities.
+    """
+    return (
+        json.dumps(jsonable_encoder(value))
+        .replace("<", "\\u003c")
+        .replace(">", "\\u003e")
+        .replace("&", "\\u0026")
+    )
+
+
+def _js_single_quoted_str_content(value: str) -> str:
+    """
+    Escape a string to be embedded inside a single-quoted JavaScript string literal
+    in an HTML `<script>` tag.
+    """
+    return _html_safe_json(str(value))[1:-1].replace("'", "\\u0027")
+
