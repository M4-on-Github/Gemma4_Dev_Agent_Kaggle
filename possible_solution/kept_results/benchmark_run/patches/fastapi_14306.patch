+# Cache for endpoint context to avoid re-extracting (file I/O) on every validation
+# error. Keyed by id(), storing the function itself too, so that the id can't be
+# reused by a different object while the entry exists.
+_endpoint_context_cache: Dict[int, Tuple[Any, EndpointContext]] = {}
+
+
+def _extract_endpoint_context(func: Any) -> EndpointContext:
+    """Extract endpoint context (file, line, function name) with caching."""
+    func_id = id(func)
+
+    cached = _endpoint_context_cache.get(func_id)
+    if cached is not None and cached[0] is func:
+        return cached[1]
+
+    ctx: EndpointContext = {}
+    try:
+        source_file = inspect.getsourcefile(func)
+        if source_file is not None:
+            ctx["file"] = source_file
+        line_number = inspect.getsourcelines(func)[1]
+        if line_number is not None:
+            ctx["line"] = line_number
+    except Exception:
+        pass
+    func_name = getattr(func, "__name__", None)
+    if func_name is not None:
+        ctx["function"] = func_name
+
+    _endpoint_context_cache[func_id] = (func, ctx)
+    return ctx
+
+
+def _get_endpoint_context(
+    dependant: Dependant, method: Optional[str], root_path: str = ""
+) -> EndpointContext:
+    ctx: EndpointContext = (
+        EndpointContext(**_extract_endpoint_context(dependant.call))
+        if dependant.call is not None
+        else EndpointContext()
+    )
+    if dependant.path:
+        # For mounted sub-apps, include the mount path prefix
+        mount_path = root_path.rstrip("/")
+        prefix = f"{method} " if method else ""
+        ctx["path"] = f"{prefix}{mount_path}{dependant.path}"
+    return ctx
+
