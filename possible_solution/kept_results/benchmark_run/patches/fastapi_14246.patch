+    # Nested models have to be generated in the same mode as the field that
+    # references them, otherwise models only used in responses (serialization)
+    # would also be generated in validation mode (and vice versa), making them
+    # be split into "-Input" and "-Output" schemas when they shouldn't.
+    validation_fields = [
+        field for field in fields if (override_mode or field.mode) == "validation"
+    ]
+    serialization_fields = [
+        field for field in fields if (override_mode or field.mode) == "serialization"
+    ]
+    flat_validation_models = get_flat_models_from_fields(
+        validation_fields, known_models=set()
+    )
+    flat_serialization_models = get_flat_models_from_fields(
+        serialization_fields, known_models=set()
+    )
+    validation_types = {f.type_ for f in validation_fields}
+    serialization_types = {f.type_ for f in serialization_fields}
+    unique_flat_model_fields = [
+        ModelField(
+            field_info=FieldInfo(annotation=model),
+            name=model.__name__,
+            mode="validation",
+        )
+        for model in flat_validation_models
+        if model not in validation_types
+    ] + [
+        ModelField(
+            field_info=FieldInfo(annotation=model),
+            name=model.__name__,
+            mode="serialization",
+        )
+        for model in flat_serialization_models
+        if model not in serialization_types
     ]
-    input_types = {f.type_ for f in fields}
